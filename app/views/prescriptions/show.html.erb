<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Prescription</h2>

    <div>
      <button onclick="window.print()" class="btn btn-success">
        🖨️ Print Prescription
      </button>

      <%= link_to "Back",
          patient_path(@prescription.patient),
          class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm p-4">
    <h4>Hospital Management System</h4>
    <hr>

    <p><strong>Patient:</strong> <%= @prescription.patient.name %></p>
    <p><strong>Doctor:</strong> <%= @prescription.doctor.name %></p>
    <p><strong>Date:</strong> <%= @prescription.created_at.strftime("%d %b %Y") %></p>

    <hr>

    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Medicine</th>
          <th>Dosage</th>
          <th>Frequency</th>
          <th>Duration</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td><%= @prescription.medicine_name %></td>
          <td><%= @prescription.dosage %></td>
          <td><%= @prescription.frequency %></td>
          <td><%= @prescription.duration %></td>
        </tr>
      </tbody>
    </table>

    <div class="mt-3">
      <strong>Doctor's Remarks:</strong>
      <p><%= @prescription.remarks.present? ? @prescription.remarks : "N/A" %></p>
    </div>

    <br><br>
    <div class="text-end">
      _______________________<br>
      Doctor Signature
    </div>
  </div>
</div>