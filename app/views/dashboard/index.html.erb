<div class="dashboard-container">

  <div class="sidebar">

  <div class="logo-section">
    <h2> Hospital</h2>
  </div>

  <div class="menu-section" style="display: flex; flex-direction: column; gap: 3px;">

    <%= link_to dashboard_path, class: "menu-item active-menu" do %>
      Dashboard
    <% end %>

    <%= link_to patients_path, class: "menu-item" do %>
      Patients
    <% end %>
    
    <%= link_to appointments_path, class: "menu-item" do %>
      Appointments
    <% end %>

    <%= link_to "Billing", bills_path,
      class: "menu-item" %>

    <a href="#" class="menu-item">
      Reports
    </a>

    <a href="#" class="menu-item">
      Settings
    </a>

  </div>

  <div class="logout-section">
    <%= button_to "Logout", logout_path, method: :delete, class: "logout-btn" %>
  </div>

  

</div>

  <div class="main-content">
    <div class="navbar">
      <h1>Dashboard</h1>
    </div>

    <div class="cards">

    <%= link_to patients_path, class: "text-decoration-none" do %>
    <div class="dashboard-card card p-4 shadow-sm">
    <h6 class="text-dark">Total Patients</h6>
    <h2 class="text-primary">
    <%= @total_patients %>
    </h2>
  </div>
<% end %>

    <%= link_to doctors_path, class: "text-decoration-none" do %>
        <div class="dashboard-card card p-4 shadow-sm">
          <h6 class="text-dark">Total Doctors</h6>
          <h2 class="text-primary"><%= @total_doctors %></h2>
        </div>
      <% end %>

      <%= link_to appointments_path, class: "text-decoration-none" do %>
        <div class="dashboard-card card p-4 shadow-sm">
        <h6 class="text-dark">Total Appointments</h6>
        <h2 class="text-primary"><%= @total_appointments %></h2>
        </div>

        <div class="dashboard-card card p-4 shadow-sm">
        <h6 class="text-dark">Revenue</h6>
        <p>₹<%= Bill.where(status: "Paid")
         .sum(:amount) %></p>
        <%end%>
      </div>

</div>