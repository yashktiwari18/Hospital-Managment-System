<div class="page-container">

  <div class="page-header">
    <%= render "shared/page_header",
    title: "Doctors",
    breadcrumb: "Dashboard > Doctors",
    button_path: signup_path(role: "doctor")%>
  </div>
    <div class="header-buttons">
      <%= link_to "Dashboard", dashboard_path, class: "dashboard-btn" %>
    </div>
    
  </div>

  <div class="mb-3">
  <%= link_to "Export Excel",
  export_doctors_path(format: :xlsx),
  class: "btn btn-success" %>
</div>

  <table>
    <tr>

    <th>ID</th>
    <th>Name</th>
    <th>Age</th>
    <th>Gender</th>
    <th>Phone</th>
    <th>Address</th>
    <th>Education</th>
    <th>Specialization</th>
    <th>Field</th>


    </tr>

    <% @doctors.each do |doctor| %>
    <tr>
    <td><%= doctor.id %></td>
    <td><%= doctor.name %></td>
    <td><%= doctor.age %></td>
    <td><%= doctor.gender %></td>
    <td><%= doctor.phone %></td>
    <td><%= doctor.address %></td>
    <td><%= doctor.education %></td>
    <td><%= doctor.specialization %></td>
    <td><%= doctor.field %></td>

    <td>
  <div class="d-flex gap-2">

    <%= link_to "Edit",
    edit_doctor_path(doctor),
    class: "btn btn-primary btn-sm" %>

    <%= link_to "Delete",
    doctor_path(doctor),
    data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?"
},
class: "btn btn-danger btn-sm" %>

  </div>
</td>
    </tr>
    <% end %>

  </table>

  <div class="pagination-container">
  <%= paginate @doctors %>
  </div>

</div>