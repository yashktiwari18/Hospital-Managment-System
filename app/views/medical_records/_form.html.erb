<%= form_with model: medical_record do |form| %>

  <%= form.hidden_field :patient_id %>
  <%= form.hidden_field :doctor_id %>
  <%= form.hidden_field :appointment_id %>

  <div class="mb-3">
    <%= form.label :diagnosis %>
    <%= form.text_area :diagnosis,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :prescription %>
    <%= form.text_area :prescription,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :chief_complaint %>
    <%= form.text_field :chief_complaint,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :symptoms %>
    <%= form.text_area :symptoms,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :doctor_notes %>
    <%= form.text_area :doctor_notes,
        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :follow_up_date %>
    <%= form.date_field :follow_up_date,
        class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-success" %>

<% end %>