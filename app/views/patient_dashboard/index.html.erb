<div class="container py-5">

  <div class="text-center mb-5">
    <h1 class="fw-bold">
      Welcome, <%= current_user.name %>
    </h1>

    <p class="text-muted">
      Patient Dashboard
    </p>
  </div>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body text-center">

          <h5 class="fw-bold">
            Book Appointment
          </h5>

          <p class="text-muted">
            Schedule an appointment with a doctor
          </p>

          <%= link_to "Book Now",
              new_appointment_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body text-center">

          <h5 class="fw-bold">
            My Appointments
          </h5>

          <p class="text-muted">
            View all your appointments
          </p>

          <%= link_to "View",
            patient_appointments_path,
            class: "btn btn-success" %>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body text-center">

          <h5 class="fw-bold">
            My Profile
          </h5>

          <p class="text-muted">
            View your profile details
          </p>

          <%= link_to "Profile",
              profile_path,
              class: "btn btn-dark" %>

        </div>
      </div>
    </div>

    <%= link_to "Medical History",
        medical_history_path,
        class: "btn btn-primary" %>

  </div>

</div>