<div class="hero"
     style="background-image: url('<%= asset_path("home.png") %>');
            min-height:100vh;
            background-size:cover;
            background-position:center;
            display:flex;
            align-items:flex-start;
            justify-content:center;
            padding-top:120px;">

  <div class="container py-5">

  <h1 class="text-center fw-bold mb-5 text-black">
    Signup As
  </h1>

  <div class="row justify-content-center g-4">


    <div class="col-md-4">
      <%= link_to signup_path(role: "doctor"),
      class: "text-decoration-none" do %>

        <div class="card shadow-sm p-5 text-center role-card">
          <h3 class="text-dark">Doctor</h3>
        </div>

      <% end %>
    </div>

    <div class="col-md-4">
      <%= link_to signup_path(role: "patient"),
      class: "text-decoration-none" do %>

        <div class="card shadow-sm p-5 text-center role-card">
          <h3 class="text-dark">Patient</h3>
        </div>


      <% end %>
    </div>

  </div>
</div>
</div>