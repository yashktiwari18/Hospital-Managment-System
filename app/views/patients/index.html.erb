<div class="page-container">

  <div class="page-header">
    <%= render "shared/page_header",
    title: "Patients",
    breadcrumb: "Dashboard > Patients",
    button_path: new_patient_path %>
    </div>
  </div>
    <%= link_to "Dashboard", dashboard_path, class: "dashboard-btn" %>
    <%= link_to "Add Patient", "/patients/new", class: "add-btn" %>
  </div>

  <div class="mb-3">
  <%= link_to "Export Excel",
  export_patients_path(format: :xlsx),
  class: "btn btn-success" %>
  </div>

  <table>
    <tr>

    <th>ID</th>
    <th>Name</th>
    <th>Age</th>
    <th>Gender</th>
    <th>Phone</th>
    <th>Address</th>

    </tr>

    <% @patients.each do |patient| %>
    <tr>
    <td><%= patient.id %></td>
    <td>
      <%= link_to patient.name,
        patient_path(patient),
        style: "text-decoration:none; font-weight:500;" %>
    </td>
    <td><%= patient.age %></td>
    <td><%= patient.gender %></td>
    <td><%= patient.phone %></td>
    <td><%= patient.address %></td>

    <td>
    <div class="d-flex gap-2">
    <%= link_to "Edit",
    edit_patient_path(patient),
    class: "btn btn-primary btn-sm" %>

<%= link_to "Delete",
    patient_path(patient),
    data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?"
},
class: "btn btn-danger btn-sm" %>
</div>

    </td>
    </tr>
    <% end %>
    
  </table>

  <div class="pagination-container">
  <%= paginate @patients %>
  </div>

</div>