<div class="mb-3">
  <%= link_to "← Back to Patients",
      patients_path,
      class: "btn btn-outline-secondary" %>
</div>


<div class="container-fluid px-4 py-4">
  <h1><%= @patient.name %></h1>

  <hr>

  <div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="mb-3"><%= @patient.name %></h2>

    <div class="row">
      <div class="col-md-3">
        <strong>Age</strong><br>
        <%= @patient.age %>
      </div>

      <div class="col-md-3">
        <strong>Gender</strong><br>
        <%= @patient.gender %>
      </div>

      <div class="col-md-3">
        <strong>Phone</strong><br>
        <%= @patient.phone %>
      </div>

      <div class="col-md-3">
        <strong>Address</strong><br>
        <%= @patient.address %>
      </div>
    </div>
  </div>
</div>


<div class="d-flex gap-2 mb-4">
  <%= link_to "➕ Add Prescription",
      new_prescription_path(patient_id: @patient.id),
      class: "btn btn-success" %>

  <%= link_to "➕ Add Medical Record",
      new_medical_record_path(patient_id: @patient.id),
      class: "btn btn-primary" %>

  <%= link_to "➕ Upload Test Report",
      new_test_report_path(patient_id: @patient.id),
      class: "btn btn-warning text-dark" %>
</div>

  <hr>

  <div class="card shadow-sm mb-4">
  <div class="card-header">
    <h4 class="mb-0">Medical Records</h4>
  </div>

  <div class="card-body">
    <% if @medical_records.any? %>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>Diagnosis</th>
            <th>Follow Up</th>
          </tr>
        </thead>
        <tbody>
          <% @medical_records.each do |record| %>
            <tr>
              <td><%= record.diagnosis %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">No medical records available.</p>
    <% end %>
  </div>
</div>

  <hr>

 <div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h4 class="mb-0">Prescriptions</h4>

    <%= link_to "➕ New Prescription",
        new_prescription_path(patient_id: @patient.id),
        class: "btn btn-success btn-sm" %>
  </div>

  <div class="card-body p-0">
  <% if @prescriptions.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover mb-0">
    <thead>
      <tr>
        <th>Medicine</th>
        <th>Dosage</th>
        <th>Frequency</th>
        <th>Duration</th>
        <th>Action</th>
      </tr>
    </thead>

<tbody>
  <% @prescriptions.each do |prescription| %>
    <tr>
      <td><%= prescription.medicine_name %></td>
      <td><%= prescription.dosage %></td>
      <td><%= prescription.frequency %></td>
      <td><%= prescription.duration %></td>
      <td>
        <%= link_to "View",
            prescription_path(prescription),
            class: "btn btn-primary btn-sm" %>
      </td>
    </tr>
  <% end %>
</tbody>
</table>
</div>
    <% else %>
      <p class="text-muted">No prescriptions added yet.</p>
    <% end %>
  </div>
