<div id="<%= dom_id appointment %>">
  <div>
    <strong>Patient:</strong>
    <%= appointment.patient_id %>
  </div>

  <div>
    <strong>Doctor:</strong>
    <%= appointment.doctor_id %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= appointment.date %>
  </div>

  <div>
    <strong>Time:</strong>
    <%= appointment.time %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= appointment.status %>
  </div>

</div>
