<h2>Patient Appointments</h2>

<table class="table">
  <thead>
    <tr>
      <th>Patient</th>
      <th>Date</th>
      <th>Status</th>
    </tr>
  </thead>

  <tbody>
    <% @appointments.each do |appointment| %>
    <tr>
        <td>
          <%= appointment.patient.name %>
        </td>

        <td>
          <%= appointment.date %>
        </td>

        <td>
          <%= appointment.status %>
        </td>
        <td>
          <%= link_to "View",
              appointment_path(appointment),
              class: "btn btn-sm btn-primary" %>
        </td>
    </tr>
    <% end %>
  </tbody>
</table>

